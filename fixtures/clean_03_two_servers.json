{
  "servers": [
    {
      "name": "calendar",
      "config": {
        "command": "node",
        "args": [
          "server.js"
        ],
        "env": {
          "CAL_API_TOKEN": "${CAL_API_TOKEN}"
        }
      },
      "tools": [
        {
          "name": "list_events",
          "description": "List events for a day.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "name": "weather",
      "config": {
        "command": "node",
        "args": [
          "server.js"
        ]
      },
      "tools": [
        {
          "name": "get_forecast",
          "description": "Get the forecast for a city name.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string",
                "maxLength": 80
              }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
