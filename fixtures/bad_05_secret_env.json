{
  "name": "tickets",
  "config": {
    "command": "node",
    "args": [
      "server.js"
    ],
    "env": {
      "TICKETS_API_TOKEN": "hunter2-synthetic-value"
    }
  },
  "tools": [
    {
      "name": "list_tickets",
      "description": "List open tickets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
